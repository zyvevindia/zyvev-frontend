# EVSavari frontend — environment template
# ----------------------------------------
# Recommended: copy this file to ".env.local" and edit there (gitignored).
#   cp .env.example .env.local
#
# Vite load order (later wins): .env → .env.local → .env.[mode] → .env.[mode].local
# See: https://vitejs.dev/guide/env-and-mode.html

# Backend API base URL (no trailing slash). Local dev default:
VITE_API_URL=http://localhost:5000

# Optional: Google Analytics 4 measurement ID (omit or leave empty to disable)
# VITE_GA_ID=G-XXXXXXXXXX
