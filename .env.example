# EVSavari frontend — environment template
# ----------------------------------------
# Recommended: copy this file to ".env.local" and edit there (gitignored).
#   cp .env.example .env.local
#
# Vite load order (later wins): .env → .env.local → .env.[mode] → .env.[mode].local
# See: https://vitejs.dev/guide/env-and-mode.html

# Backend API base URL (no trailing slash). Local dev default:
# Requires backend running: cd ../zyvev-backend && npm run dev  (port 5000)
# Quick check: npm run check:api
VITE_API_URL=http://localhost:5000

# Cloudinary cloud name for catalog image delivery (default: dznvmumze)
# VITE_CLOUDINARY_CLOUD_NAME=dznvmumze

# Cloudinary Admin API (scripts/cloudinary-fix-publicids.mjs only — do not expose secret to Vite)
# CLOUDINARY_CLOUD_NAME=dznvmumze
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Analytics & monitoring (soft launch) ---
# Google Analytics 4 (required baseline for product analytics)
# VITE_GA_ID=G-XXXXXXXXXX

# PostHog (optional — product analytics)
# VITE_POSTHOG_KEY=phc_xxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (frontend error monitoring)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_APP_ENV=production
# VITE_APP_RELEASE=evsavari-frontend@1.0.0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# VITE_ANALYTICS_ENABLED=true
# VITE_ANALYTICS_REQUIRE_CONSENT=false
# VITE_ANALYTICS_DEBUG=false

# Optional: fetch master catalog detail for gold-tier slugs (staging only; keep false in production)
# VITE_CATALOG_DETAIL_ENRICH=false

# Optional: show catalog intelligence UI (decision blocks, persona fit; staging only)
# VITE_CATALOG_INTELLIGENCE=false

# SEO decision pages use static /public/seo-data/*.json by default.
# Set true to prefer live API when SEO_PAGES_ENABLED=true on backend:
# VITE_SEO_PAGES=true

# --- Controlled public beta (Week 1 live ops) ---
# VITE_LAUNCH_PROFILE=public-beta
# VITE_CATALOG_INTELLIGENCE=true
# VITE_CATALOG_DETAIL_ENRICH=true
# VITE_SEO_PAGES=true
# VITE_BEHAVIORAL_INTELLIGENCE=true

# Anonymous buyer intent events (requires BEHAVIORAL_INTELLIGENCE_ENABLED on backend)
# VITE_BEHAVIORAL_INTELLIGENCE=true

# WhatsApp sales line for buyer CTAs (country code + number, digits only e.g. 9198xxxxxxxx)
# VITE_WHATSAPP_SALES_NUMBER=9198xxxxxxxx

# Cloudflare Turnstile (low-intent forms: feedback, contact, newsletter)
# VITE_TURNSTILE_SITE_KEY=
# Backend: TURNSTILE_SECRET_KEY= and TURNSTILE_SITE_KEY= (required in production)

# Launch profile: staging | soft-launch | public-beta
# VITE_LAUNCH_PROFILE=soft-launch

# Optional soft-launch copy (shown under the profile banner when set; keep short)
# VITE_LAUNCH_ACK_LINE=Thanks for early feedback — we read every report.
# VITE_LAUNCH_KNOWN_LIMITATION=Dealer prices and on-ground offers may differ from indicative listings.
# VITE_MAINTENANCE_NOTE=
# VITE_INTERNAL_BETA_TAG=Internal beta

# Optional controlled-public ops copy (concise; comma-separated known issues OK for OPS_KNOWN_ISSUES)
# VITE_BETA_FEEDBACK_ACK_LINE=Thanks — we triage beta reports within 48 hours.
# VITE_OPS_RELEASE_SUMMARY=Week 1: trust copy refresh on top families + compare latency checks.
# VITE_OPS_KNOWN_ISSUES=GSC data can lag 24–48h,Some city charging pages await verifier refresh

# --- Production deploy smoke (CLI only — not read by Vite) ---
# Used by: npm run deploy:smoke
# EVSAVARI_SITE_ORIGIN=https://evsavari.com
# EVSAVARI_API_URL=https://evsavari-api.onrender.com
# EVSAVARI_CLOUDINARY_NAME=dznvmumze
# Optional overrides for deep paths probed by deploy:smoke:
# EVSAVARI_DEPLOY_SMOKE_COMPARE_PATH=/compare/tata-nexon-ev-vs-mg-zs-ev
# EVSAVARI_DEPLOY_SMOKE_DISCOVER_PATH=/discover/city-driving
