{
  "name": "evsavari-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sitemaps": "node scripts/build-sitemaps.mjs",
    "content:generate": "node scripts/generate-content.mjs",
    "gsc:verify": "node scripts/verify-gsc-readiness.mjs",
    "prebuild": "npm run content:generate && npm run build:sitemaps",
    "lint": "eslint .",
    "seo:qa": "node scripts/seo-qa.mjs",
    "seo:foundation": "node scripts/seo-foundation-smoke.mjs",
    "ops:analytics-smoke": "node scripts/ops-analytics-smoke.mjs",
    "intelligence:smoke": "node scripts/intelligence-smoke.mjs",
    "intelligence:phase2-smoke": "node scripts/intelligence-phase2-smoke.mjs",
    "trust:smoke": "node scripts/trust-layer-smoke.mjs",
    "catalog-ops:smoke": "node scripts/catalog-ops-smoke.mjs",
    "ops:usage-learning-smoke": "node scripts/ops-usage-learning-smoke.mjs",
    "soft-launch:smoke": "node scripts/soft-launch-smoke.mjs",
    "post-launch:smoke": "npm run seo:qa && npm run trust:smoke && npm run soft-launch:smoke && npm run catalog-ops:smoke && npm run intelligence:smoke && npm run ops:usage-learning-smoke",
    "ingestion:smoke": "node scripts/ingestion-smoke.mjs",
    "media:audit": "node scripts/media-audit.mjs",
    "media:fix-cloudinary": "node scripts/cloudinary-fix-publicids.mjs",
    "media:discover-cloudinary": "node scripts/cloudinary-fix-publicids.mjs --discover",
    "launch:smoke": "node scripts/launch-smoke.mjs",
    "launch:validate": "node scripts/launch-validate.mjs",
    "check:api": "node scripts/check-local-api.mjs",
    "preview": "vite preview",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "deploy:repo-check": "node scripts/deployment-repo-validation.mjs",
    "ci:full": "npm run deploy:repo-check && npm run build && npm run post-launch:smoke && npm run ingestion:smoke"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "cloudinary": "^2.9.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}