# Production build (vite build / --mode production).
# Set VITE_* in the deployment host (Vercel, Render, GitHub Actions, etc.); those
# values override file-based env at build time.
#
# If VITE_API_URL is not set anywhere, the app uses the production fallback in src/config.js.

# Required on Vercel Production (baked in at build time):
# VITE_API_URL=https://evsavari-api.onrender.com

# Optional: Google Analytics 4 (omit to disable client-side GA)
# VITE_GA_ID=G-XXXXXXXXXX
