{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVSavari Golden Catalog Dossier",
  "type": "object",
  "required": ["id", "displayName", "familySlug", "vehicle", "fields", "variants"],
  "properties": {
    "id": { "type": "string" },
    "displayName": { "type": "string" },
    "familySlug": { "type": "string" },
    "verifiedAt": { "type": "string", "format": "date" },
    "verificationLevel": { "enum": ["verified_dossier", "manual_review", "ops_benchmark"] },
    "sources": { "type": "array", "items": { "type": "string" } },
    "vehicle": {
      "type": "object",
      "properties": {
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "bodyType": { "type": "string" },
        "familySlug": { "type": "string" }
      }
    },
    "fields": {
      "type": "object",
      "description": "Scalar benchmark values keyed by extraction schema field names"
    },
    "features": {
      "type": "object",
      "description": "Feature flags for feature accuracy benchmarking"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variantName", "priceInr"],
        "properties": {
          "variantName": { "type": "string" },
          "priceInr": { "type": "number" },
          "batteryKwh": { "type": "number" },
          "rangeKm": { "type": "number" },
          "acChargingKw": { "type": "number" },
          "dcChargingKw": { "type": "number" },
          "features": { "type": "object" }
        }
      }
    }
  }
}
